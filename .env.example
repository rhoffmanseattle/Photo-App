# Local environment variables for the Flickr build script.
# Copy this file to .env and fill in real values. Never commit .env.
# In production, the same variables are set in the Netlify UI under
# Site settings -> Environment variables.

# Public Flickr API key. Generate at https://www.flickr.com/services/apps/
FLICKR_API_KEY=

# Your Flickr NSID (user ID), format like 12345678@N00.
# Look it up at https://www.webfx.com/tools/idgettr/
FLICKR_USER_ID=
